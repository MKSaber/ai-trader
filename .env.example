# LSE Pattern Lab — example environment (no secrets)
POSTGRES_USER=lse
POSTGRES_PASSWORD=lse_dev_password
POSTGRES_DB=lse_pattern_lab
DATABASE_URL=postgresql+psycopg://lse:lse_dev_password@db:5432/lse_pattern_lab
REDIS_URL=redis://redis:6379/0

# Storage: local (Docker) or s3
OBJECT_STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/data
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# Market data: yfinance (default) | fixture
MARKET_DATA_PROVIDER=yfinance
# Explicit offline/demo only — never silently substituted for live failures
DEMO_MODE=false

# Research defaults
DEFAULT_HORIZON=next_session_open_to_close
INTRADAY_INTERVAL_MINUTES=5
COMMISSION_BPS=5
SPREAD_BPS=10
SLIPPAGE_BPS=5
STAMP_DUTY_RATE=0.01
INITIAL_PAPER_CASH_GBP=100000

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_MB=25
